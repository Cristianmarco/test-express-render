<section class="cli-section">
  <div class="cli-top">
    <h2><i class="fas fa-cart-shopping"></i> Compras sugeridas</h2>
    <div class="cli-stats" id="cmp-stats"></div>
  </div>

  <div class="cli-card">
    <div class="cmp-filtros">
      <select id="cmp-pedido" title="Pedido"><option value="">Todos los pedidos con pendientes</option></select>
      <select id="cmp-licitacion" title="Licitación"><option value="">Todas las licitaciones</option></select>
      <select id="cmp-dias" title="Período del consumo real que se toma como base">
        <option value="60">Consumo de los últimos 60 días</option>
        <option value="90">Consumo de los últimos 90 días</option>
        <option value="180" selected>Consumo de los últimos 180 días</option>
        <option value="365">Consumo del último año</option>
      </select>
      <select id="cmp-fuente" title="De dónde sale cuánto repuesto lleva cada equipo">
        <option value="auto">Consumo real (si no hay, ficha)</option>
        <option value="ficha">Ficha técnica (si no hay, consumo)</option>
      </select>
      <button type="button" class="cli-btn primario" id="cmp-recalcular"><i class="fas fa-calculator"></i> Recalcular</button>
    </div>
    <div id="cmp-base" class="cli-aviso-box" style="display:none"></div>

    <div class="cli-tabs">
      <button type="button" class="cli-tab activa" data-pestana="proveedores">Por proveedor</button>
      <button type="button" class="cli-tab" data-pestana="equipos">Por equipo</button>
      <button type="button" class="cli-tab" data-pestana="faltan">Faltan datos <span class="cli-badge" id="cmp-badge-faltan"></span></button>
    </div>
    <div id="cmp-contenido"><div class="cli-ficha-vacia"><i class="fas fa-spinner fa-spin"></i> Calculando...</div></div>
  </div>
</section>
