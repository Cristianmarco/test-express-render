<section class="cli-section">
  <div class="cli-top">
    <h2><i class="fas fa-users"></i> Clientes</h2>
    <div class="cli-stats" id="cli-stats"></div>
  </div>

  <div class="cli-layout">
    <!-- Listado -->
    <div class="cli-card">
      <div class="cli-toolbar">
        <input type="search" id="cli-buscar" placeholder="Buscar código, nombre, CUIT, localidad..." autocomplete="off" />
        <select id="cli-filtro-tipo" title="Tipo">
          <option value="">Todos</option>
          <option value="externo">Externos</option>
          <option value="interno">Internos</option>
        </select>
        <select id="cli-filtro-rubro" title="Rubro"><option value="">Todos los rubros</option></select>
        <select id="cli-filtro-estado" title="Estado">
          <option value="activos">Activos</option>
          <option value="inactivos">Inactivos</option>
          <option value="todos">Activos e inactivos</option>
        </select>
        <label title="Sin email o sin teléfono"><input type="checkbox" id="cli-filtro-incompletos"> Incompletos</label>
      </div>

      <div class="cli-tabla-wrap">
        <table class="cli-tabla">
          <thead>
            <tr>
              <th data-orden="codigo">Código</th>
              <th data-orden="nombre">Cliente</th>
              <th data-orden="localidad">Localidad</th>
              <th data-orden="en_taller" class="num" title="Equipos pendientes en R.Vigentes">En taller</th>
              <th data-orden="ultima_reparacion" title="Última reparación en la planilla">Últ. rep.</th>
            </tr>
          </thead>
          <tbody id="tbody-clientes-ref"></tbody>
        </table>
      </div>

      <div class="cli-acciones-lista">
        <button type="button" class="cli-btn primario" id="btn-cli-agregar"><i class="fas fa-plus"></i> Nuevo cliente</button>
        <a class="cli-btn" id="btn-cli-exportar" href="/api/clientes/exportar"><i class="fas fa-file-excel"></i> Exportar Excel</a>
      </div>
    </div>

    <!-- Ficha -->
    <div class="cli-card" id="cli-ficha">
      <div class="cli-ficha-vacia"><i class="fas fa-id-card"></i> Elegí un cliente para ver su ficha</div>
    </div>
  </div>

  <div class="clientes-modales">
    <%- include("../partials/modales/clientes_modales.ejs") %>
  </div>
</section>
