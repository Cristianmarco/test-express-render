<!-- Modal: Alta/Edicion de Producto -->
<div id="modal-agregar-producto" class="modal-refactor" style="display:none;">
  <div class="modal-contenido-refactor modal-erp-producto modal-agregar-producto-grande">
    <span class="cerrar" onclick="document.getElementById('modal-agregar-producto').style.display='none'">&times;</span>
    <h2 class="modal-titulo-principal"><i class="fas fa-box"></i> Producto</h2>

    <form id="form-producto-refactor" autocomplete="off">
      <div class="form-grid doble">
        <div>
          <label>Codigo *</label>
          <input name="codigo" required placeholder="Ej: NOSSO RNB145298" />
        </div>
        <div>
          <label>Codigo de fabricante</label>
          <input name="codigo_fabricante" placeholder="Ej: RNB 145298 (si queda vacío se toma del código)" />
        </div>
      </div>

      <div class="form-grid">
        <div>
          <label>Descripcion *</label>
          <input name="descripcion" required />
        </div>
      </div>

      <div class="form-grid doble">
        <div>
          <label>Equivalencia</label>
          <input name="equivalencia" />
        </div>
        <div>
          <label>Códigos de barras</label>
          <div class="cb-editor" id="prod-cb-editor">
            <div class="cb-agregar">
              <input type="text" id="prod-cb-input" placeholder="Escaneá o escribí y Enter" autocomplete="off" />
              <button type="button" id="prod-cb-btn" class="btn-secundario" title="Agregar código"><i class="fas fa-plus"></i></button>
            </div>
            <div class="cb-chips" id="prod-cb-chips"></div>
          </div>
          <input type="hidden" name="codigos_barra" id="prod-codigos-barra" />
        </div>
      </div>

      <div class="form-grid">
        <div>
          <label>Descripcion adicional</label>
          <textarea name="descripcion_adicional" rows="2"></textarea>
        </div>
      </div>

      <div class="form-grid">
        <div>
          <label>Familias</label>
          <div id="prod-familias-box" style="width:100%; box-sizing:border-box; border:1px solid #dbe3ee; border-radius:10px; background:#fff;">
            <div style="padding:8px 10px; border-bottom:1px solid #eef2f7; font-size:12px; font-weight:600; color:#475569;">
              Seleccione una o varias familias
            </div>
            <div id="prod-familias-checklist" style="width:100%; max-height:260px; overflow:auto; padding:8px 10px; box-sizing:border-box;">
              <div style="color:#64748b; font-size:12px;">Cargando familias...</div>
            </div>
          </div>
        </div>
      </div>

      <div class="form-grid doble">
        <div>
          <label>Grupo</label>
          <select id="prod-grupo_id" name="grupo_id"></select>
        </div>
        <div>
          <label>Marca</label>
          <select id="prod-marca_id" name="marca_id"></select>
        </div>
      </div>

      <div class="form-grid doble">
        <div>
          <label>Categoria (una)</label>
          <select id="prod-categoria_id" name="categoria_id"></select>
        </div>
        <div>
          <label>Proveedor</label>
          <select id="prod-proveedor_id" name="proveedor_id"></select>
        </div>
      </div>

      <div class="form-grid doble">
        <div>
          <label>Origen</label>
          <input name="origen" />
        </div>
        <div>
          <label>IVA</label>
          <select name="iva_tipo">
            <option value="">-</option>
            <option value="0">0%</option>
            <option value="10.5">10.5%</option>
            <option value="21">21%</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn-guardar">
        <i class="fas fa-save"></i> Guardar
      </button>
    </form>
  </div>
</div>

<!-- Modal: Movimiento de Stock -->
<div id="modal-mov-stock" class="modal-refactor" style="display:none;">
  <div class="modal-contenido-refactor modal-erp-producto">
    <span class="cerrar" onclick="document.getElementById('modal-mov-stock').style.display='none'">&times;</span>
    <h2 class="modal-titulo-principal"><i class="fas fa-dolly"></i> Movimiento de Stock</h2>

    <form id="form-mov-stock-refactor" autocomplete="off">
      <div class="form-grid doble">
        <div>
          <label>Deposito</label>
          <select id="mov-deposito" name="deposito_id" required></select>
        </div>
        <div>
          <label>Tipo</label>
          <select id="mov-tipo" name="tipo" required>
            <option value="ENTRADA">Entrada</option>
            <option value="SALIDA">Salida</option>
          </select>
        </div>
      </div>
      <div class="form-grid">
        <div>
          <label>Cantidad</label>
          <input type="number" min="1" step="1" id="mov-cantidad" name="cantidad" required />
        </div>
      </div>
      <div class="form-grid">
        <div>
          <label>Observacion</label>
          <textarea id="mov-observacion" name="observacion" rows="2"></textarea>
        </div>
      </div>
      <button type="submit" class="btn-guardar">
        <i class="fas fa-save"></i> Confirmar movimiento
      </button>
    </form>
  </div>
</div>

