<section class="cli-section">
  <div class="cli-top">
    <h2><i class="fas fa-truck"></i> Proveedores</h2>
    <div class="cli-stats" id="prov-stats"></div>
  </div>

  <div class="cli-layout">
    <!-- Listado -->
    <div class="cli-card">
      <div class="cli-toolbar">
        <input type="search" id="prov-buscar" placeholder="Buscar código, nombre, rubro, CUIT..." autocomplete="off" />
        <select id="prov-filtro-rubro" title="Rubro"><option value="">Todos los rubros</option></select>
        <select id="prov-filtro-estado" title="Estado">
          <option value="activos">Activos</option>
          <option value="inactivos">Inactivos</option>
          <option value="todos">Activos e inactivos</option>
        </select>
        <label title="Con importador automático de fichas y precios"><input type="checkbox" id="prov-filtro-importador"> Con importador</label>
        <label title="Sin email o sin teléfono"><input type="checkbox" id="prov-filtro-incompletos"> Incompletos</label>
      </div>

      <div class="cli-tabla-wrap">
        <table class="cli-tabla">
          <thead>
            <tr>
              <th data-orden="codigo">Código</th>
              <th data-orden="nombre">Proveedor</th>
              <th data-orden="productos" class="num">Productos</th>
              <th data-orden="ultima_sync" title="Última actualización de precios desde la página del proveedor">Últ. sinc.</th>
            </tr>
          </thead>
          <tbody id="tbody-proveedores-ref"></tbody>
        </table>
      </div>

      <div class="cli-acciones-lista">
        <button type="button" class="cli-btn primario" id="btn-prov-agregar"><i class="fas fa-plus"></i> Nuevo proveedor</button>
        <a class="cli-btn" href="/api/proveedores/exportar"><i class="fas fa-file-excel"></i> Exportar Excel</a>
      </div>
    </div>

    <!-- Ficha -->
    <div class="cli-card" id="prov-ficha">
      <div class="cli-ficha-vacia"><i class="fas fa-truck"></i> Elegí un proveedor para ver su ficha</div>
    </div>
  </div>

  <div class="proveedores-modales">
    <%- include("../partials/modales/proveedores_modales.ejs") %>
  </div>
</section>
