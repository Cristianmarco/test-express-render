<%
  const pesos = (n) => Number(n || 0).toLocaleString('es-AR', { style: 'currency', currency: 'ARS', minimumFractionDigits: 2 });
  const fecha = (iso) => { const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? `${m[3]}/${m[2]}/${m[1]}` : ''; };
  const o = orden;
  const domicilio = [o.direccion, o.codigo_postal ? `(CP ${o.codigo_postal})` : null, o.localidad, o.provincia].filter(Boolean).join(' · ');
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= o.numero %> - <%= o.razon_social %></title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; color: #111; margin: 0; background: #f1f5f9; font-size: 12px; }
    .hoja { width: 210mm; min-height: 297mm; margin: 10px auto; background: #fff; padding: 14mm 14mm 12mm; position: relative; }
    .barra { width: 210mm; margin: 10px auto 0; display: flex; gap: 8px; }
    .barra button { padding: 8px 16px; font-size: 14px; cursor: pointer; }
    .cab { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #111; padding-bottom: 8px; }
    .cab img { height: 42px; }
    .cab .titulo { text-align: right; }
    .cab .titulo h1 { margin: 0; font-size: 20px; letter-spacing: .5px; }
    .cab .titulo div { font-size: 13px; margin-top: 3px; }
    .bloque { border: 1px solid #999; border-radius: 4px; padding: 8px 10px; margin-top: 10px; }
    .bloque b { display: inline-block; min-width: 90px; }
    h2 { font-size: 13px; text-transform: uppercase; margin: 16px 0 6px; letter-spacing: .4px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #999; padding: 5px 6px; text-align: left; }
    th { background: #eee; font-size: 11px; text-transform: uppercase; }
    .num { text-align: right; white-space: nowrap; }
    tfoot td { font-weight: 700; background: #f7f7f7; }
    .total { margin-top: 14px; display: flex; justify-content: flex-end; }
    .total div { border: 2px solid #111; padding: 8px 14px; font-size: 15px; font-weight: 700; }
    .obs { margin-top: 12px; }
    .firmas { display: flex; justify-content: space-between; gap: 30px; margin-top: 70px; }
    .firmas div { flex: 1; border-top: 1px solid #111; text-align: center; padding-top: 4px; font-size: 11px; }
    .anulada { position: absolute; top: 40%; left: 0; right: 0; text-align: center; font-size: 90px; font-weight: 700; color: rgba(185, 28, 28, .18); transform: rotate(-25deg); pointer-events: none; }
    .pie { margin-top: 18px; font-size: 10px; color: #555; }
    @media print {
      body { background: #fff; }
      .barra { display: none; }
      .hoja { margin: 0; width: auto; min-height: 0; padding: 0; }
      @page { size: A4; margin: 12mm; }
    }
  </style>
</head>
<body>
  <div class="barra">
    <button onclick="window.print()">Imprimir</button>
    <button onclick="window.close()">Cerrar</button>
  </div>
  <div class="hoja">
    <% if (o.estado === 'anulada') { %><div class="anulada">ANULADA</div><% } %>
    <div class="cab">
      <img src="/static/images/logo.png" alt="Amorim">
      <div class="titulo">
        <h1>ORDEN DE PAGO</h1>
        <div>Nº <b><%= String(o.id).padStart(8, '0') %></b><%= Number(o.cuenta) === 2 ? ' · C2' : '' %></div>
        <div>Fecha: <b><%= fecha(o.fecha) %></b></div>
      </div>
    </div>

    <div class="bloque">
      <div><b>Proveedor:</b> <%= o.razon_social %><%= o.fantasia && o.fantasia !== o.razon_social ? ` (${o.fantasia})` : '' %> · Código <%= o.codigo %></div>
      <% if (o.cuit || o.condicion_iva) { %><div><b>CUIT:</b> <%= o.cuit || '—' %><%= o.condicion_iva ? ` · ${o.condicion_iva}` : '' %></div><% } %>
      <% if (domicilio) { %><div><b>Domicilio:</b> <%= domicilio %></div><% } %>
    </div>

    <h2>Comprobantes que se cancelan</h2>
    <% if (o.facturas.length) { %>
      <table>
        <thead><tr><th>Comprobante</th><th>Fecha</th><th>Vencimiento</th><th class="num">Total comprobante</th><th class="num">Importe pagado</th></tr></thead>
        <tbody>
          <% o.facturas.forEach(f => { %>
            <tr><td><%= f.numero_completo %></td><td><%= fecha(f.fecha) %></td><td><%= fecha(f.vencimiento) %></td>
              <td class="num"><%= pesos(f.total_factura) %></td><td class="num"><%= pesos(f.importe) %></td></tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr><td colspan="4">Total imputado</td><td class="num"><%= pesos(o.imputado) %></td></tr>
          <% if (o.a_cuenta > 0.05) { %><tr><td colspan="4">Pago a cuenta</td><td class="num"><%= pesos(o.a_cuenta) %></td></tr><% } %>
        </tfoot>
      </table>
    <% } else { %>
      <div class="bloque">Pago a cuenta (sin comprobantes imputados).</div>
    <% } %>

    <h2>Medios de pago</h2>
    <table>
      <thead><tr><th>Medio</th><th>Banco</th><th>Nº operación / cheque</th><th>Fecha de cobro</th><th class="num">Importe</th></tr></thead>
      <tbody>
        <% o.medios.forEach(m => { %>
          <tr><td><%= m.medio_nombre %></td><td><%= m.banco || '' %></td><td><%= m.referencia || '' %></td><td><%= fecha(m.fecha_cobro) %></td><td class="num"><%= pesos(m.importe) %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <div class="total"><div>TOTAL PAGADO: <%= pesos(o.total) %></div></div>

    <% if (o.observaciones) { %><div class="obs"><b>Observaciones:</b> <%= o.observaciones %></div><% } %>
    <% if (o.estado === 'anulada') { %><div class="obs" style="color:#b91c1c"><b>Anulada</b><%= o.anulada_motivo ? `: ${o.anulada_motivo}` : '' %></div><% } %>

    <div class="firmas">
      <div>Autorizó</div>
      <div>Recibí conforme · Firma, aclaración y DNI</div>
    </div>
    <div class="pie">Emitida por <%= o.creado_por || '—' %></div>
  </div>
</body>
</html>
