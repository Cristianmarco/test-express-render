<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Chapas de cajones</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 10mm; color: #000; }
    .barra { margin-bottom: 10px; display: flex; gap: 12px; align-items: center; }
    .grilla { display: grid; grid-template-columns: repeat(auto-fill, 45mm); gap: 4mm; }
    .chapa { width: 45mm; border: 1px dashed #999; padding: 3mm; text-align: center; break-inside: avoid; }
    .chapa svg { width: 32mm; height: 32mm; display: block; margin: 0 auto; }
    .chapa .num { font-size: 20pt; font-weight: 700; margin-top: 1mm; letter-spacing: 1px; }
    @media print { .barra { display: none; } body { margin: 6mm; } }
  </style>
</head>
<body>
  <div class="barra">
    <button onclick="window.print()">Imprimir</button>
    <span>QR de 32 mm con corrección de errores alta (H). Cada QR contiene el código del cajón (ej: C023).</span>
  </div>
  <div class="grilla">
    <% chapas.forEach(c => { %>
      <div class="chapa"><%- c.svg %><div class="num"><%= c.nombre %></div></div>
    <% }) %>
  </div>
</body>
</html>
