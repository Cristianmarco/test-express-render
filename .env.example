DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# For Supabase pooled connection, it usually looks like:
# DATABASE_URL=postgresql://postgres.USERHASH:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# SSL options: 'require' (default enabled) or 'disable'
# If you need to disable SSL locally set:
# PGSSL=disable

# Sesion de la app (cualquier texto largo y secreto)
SESSION_SECRET=

# Credenciales de las paginas de proveedores (importador de productos).
# Son las mismas cuentas de cliente con las que se entra a cada pagina.
NOSSO_EMAIL=
NOSSO_PASSWORD=
FERMAN_USUARIO=
FERMAN_PASSWORD=
BMH_USUARIO=
BMH_PASSWORD=
DIPRA_EMAIL=
DIPRA_PASSWORD=
EXINTRADER_EMAIL=
EXINTRADER_PASSWORD=
# Rodaser no requiere login.

# Opcional: bonificacion sobre el precio de lista de cada proveedor (si cambia).
# Por defecto: Ferman 30, BMH 6, Dipra 47, Exintrader 23, Rodaser 50.
# FERMAN_DESCUENTO_PCT=
# BMH_DESCUENTO_PCT=
# DIPRA_DESCUENTO_PCT=
# EXINTRADER_DESCUENTO_PCT=
# RODASER_DESCUENTO_PCT=
